# Copy to .env and fill in the keys you have. .env is gitignored.
# Empty values are fine. The pipeline runs with no keys (Edge TTS, Wikimedia
# footage, offline scripts). A Gemini or OpenAI key is the quality upgrade.

# --- How many Shorts per day (default 5; 30 still works) ---
DAILY_SHORTS=5
# Rolling window for "fresh". Default is 36 hours. Widens automatically if the day is thin.
NEWS_WINDOW_MINUTES=2160

# --- Language model (optional) ---
# local (no key), gemini, or openai. If unset, a Gemini key alone selects gemini,
# an OpenAI key alone selects openai, and no key selects local.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Voice ---
# edge is free and returns word timings for captions. openai is the paid upgrade.
TTS_ENGINE=edge
# Leave blank to rotate voices per video. Set this only to lock one voice.
TTS_VOICE=
# Edge rate override, for example +8%. Blank uses the profile's rate.
TTS_RATE=
# Used only when TTS_ENGINE=openai. tts-1-hd is the default. gpt-4o-mini-tts accepts style instructions.
TTS_MODEL=tts-1-hd

# --- Picture ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_PRESET=medium
VIDEO_CRF=20
# Screenshot the source page and pull its lead image. Review these before upload.
CAPTURE_SOURCES=1

# --- Footage (optional; Wikimedia Commons is used with no key) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional third source. https://newsapi.org
NEWS_API_KEY=

# --- Where files go ---
OUTPUT_DIR=output
DATA_DIR=data
# Drop your own licensed tracks here (.mp3, .wav, .m4a). Empty = generated beds.
MUSIC_DIR=assets/music
FEEDS_FILE=config/feeds.yaml
# Optional override, one RSS URL per line.
RSS_FEED_URLS=

# --- Upload (all off until you opt in) ---
# DRY_RUN=1 forces "do not upload" even if AUTO_UPLOAD=1.
DRY_RUN=
# Upload previously approved videos at the end of a run.
AUTO_UPLOAD=
# Also treat today's new renders as approved. This is the explicit "no human review" switch.
SKIP_REVIEW=
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=28
YOUTUBE_TAGS=tech,technology,shorts,news

# Classic default quota: 10,000 units/day and videos.insert at about 1,600 units
# means about 6 uploads. The cap below enforces that. See README for the newer
# separate upload bucket (about 100 uploads/day) and how to raise the cap.
MAX_UPLOADS_PER_DAY=6
UPLOAD_QUOTA_COST=1600
YOUTUBE_DAILY_QUOTA_UNITS=10000

# OAuth from scripts/youtube_oauth_setup.py. Never commit the real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
