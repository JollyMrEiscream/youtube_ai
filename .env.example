# Copy to .env and fill in the keys you have. .env is gitignored.
# Empty values are fine for the script and the voice (Edge TTS, offline writer).
# The picture needs PEXELS_API_KEY, PIXABAY_API_KEY, or XAI_API_KEY.
# With none of those, a Short is rejected instead of rendered as a slideshow.

# --- How many Shorts per day (default 5; 30 still works) ---
DAILY_SHORTS=5
# Rolling window for "fresh". Default is 36 hours. Widens automatically if the day is thin.
NEWS_WINDOW_MINUTES=2160

# --- Language model (optional) ---
# local (no key), gemini, openai, or xai. If unset, a Gemini key alone selects gemini,
# an OpenAI key alone selects openai, an xAI key alone selects xai, and no key selects local.
# xai uses the OpenAI client against https://api.x.ai/v1 with XAI_API_KEY, so one key
# covers scripts and Grok clips.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XAI_MODEL=grok-4.7

# --- Voice ---
# edge is free and returns word timings for captions. openai is the paid upgrade.
TTS_ENGINE=edge
# Leave blank to rotate voices per video. Set this only to lock one voice.
TTS_VOICE=
# Edge rate override, for example +8%. Blank uses the profile's rate.
TTS_RATE=
# Used only when TTS_ENGINE=openai. tts-1-hd is the default. gpt-4o-mini-tts accepts style instructions.
TTS_MODEL=tts-1-hd

# --- Picture ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_PRESET=medium
VIDEO_CRF=20
# Off by default. News lead photos are usually copyrighted. Set to 1 to allow one
# small inset over moving footage. It is never full screen.
CAPTURE_SOURCES=

# --- Footage (real video; stills are not a substitute) ---
# Pexels Videos: https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay Videos: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# xAI Grok Imagine video, used only when stock search misses a beat.
# Key: https://console.x.ai/
# Docs: https://docs.x.ai/developers/model-capabilities/video/generation
XAI_API_KEY=
XAI_VIDEO_MODEL=grok-imagine-video-1.5
# Seconds requested from the model (1-15). The edit uses the strongest 1.5-3s.
XAI_VIDEO_DURATION=4
# Cap on generated clips per calendar day. A request counts as soon as xAI accepts
# it, including timeouts and failed jobs. A cached file does not count again.
MAX_AI_CLIPS_PER_DAY=10
# Also refuse a Short that would need more Grok clips than this, and do not spend
# any of them. Default 3.
MAX_AI_CLIPS_PER_SHORT=3
# Do not reuse a stock or generated clip across Shorts for this many days.
CLIP_REUSE_DAYS=7
# Optional third source. https://newsapi.org
NEWS_API_KEY=

# --- Where files go ---
OUTPUT_DIR=output
DATA_DIR=data
# Drop your own licensed tracks here (.mp3, .wav, .m4a). Empty = generated beds.
MUSIC_DIR=assets/music
FEEDS_FILE=config/feeds.yaml
# Optional override, one RSS URL per line.
RSS_FEED_URLS=

# --- Upload (all off until you opt in) ---
# DRY_RUN=1 forces "do not upload" even if AUTO_UPLOAD=1.
DRY_RUN=
# Upload previously approved videos at the end of a run.
AUTO_UPLOAD=
# Also treat today's new renders as approved. This is the explicit "no human review" switch.
SKIP_REVIEW=
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=28
YOUTUBE_TAGS=tech,technology,shorts,news

# Classic default quota: 10,000 units/day and videos.insert at about 1,600 units
# means about 6 uploads. The cap below enforces that. See README for the newer
# separate upload bucket (about 100 uploads/day) and how to raise the cap.
MAX_UPLOADS_PER_DAY=6
UPLOAD_QUOTA_COST=1600
YOUTUBE_DAILY_QUOTA_UNITS=10000

# OAuth from scripts/youtube_oauth_setup.py. Never commit the real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
